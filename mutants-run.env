# Every mutant of the common crate's smaller modules, against its own tests, on 16 runners.
MUTANTS_ARGS=--package pare-common --file crates/common/src/config.rs --file crates/common/src/units.rs --file crates/common/src/geom/point.rs --file crates/common/src/geom/dbu.rs --file crates/common/src/geom/interval.rs --file crates/common/src/db/indices.rs --file crates/common/src/db/library.rs --file crates/common/src/db/sdc.rs --file crates/common/src/db/shapes.rs --file crates/common/src/db/parser/lexer.rs --file crates/common/src/db/parser/segments.rs --file crates/common/src/db/parser/bookshelf.rs --file crates/common/src/db/parser/lef_rules.rs --file crates/common/src/db/writer/def.rs --file crates/common/src/db/writer/bookshelf.rs --file crates/common/src/db/writer/segments.rs --file crates/common/src/network_simplex.rs --jobs 2
MUTANTS_SHARDS=16
