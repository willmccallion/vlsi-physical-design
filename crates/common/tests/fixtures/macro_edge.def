VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN macro_edge ;
UNITS DISTANCE MICRONS 2000 ;

DIEAREA ( 0 0 ) ( 20000 10000 ) ;

TRACKS X 190 DO 53 STEP 380 LAYER M1 ;
TRACKS Y 140 DO 36 STEP 280 LAYER M1 ;
TRACKS X 190 DO 53 STEP 380 LAYER M2 ;
TRACKS Y 140 DO 36 STEP 280 LAYER M2 ;
TRACKS X 190 DO 53 STEP 380 LAYER M3 ;
TRACKS Y 140 DO 36 STEP 280 LAYER M3 ;
TRACKS X 190 DO 36 STEP 560 LAYER M4 ;
TRACKS Y 140 DO 18 STEP 560 LAYER M4 ;
TRACKS X 190 DO 36 STEP 560 LAYER M5 ;
TRACKS Y 140 DO 18 STEP 560 LAYER M5 ;

COMPONENTS 1 ;
- ram EDGE + FIXED ( 11350 1330 ) N ;
END COMPONENTS

PINS 1 ;
- drv + NET n1 + DIRECTION INPUT + USE SIGNAL
  + LAYER M3 ( -70 -70 ) ( 70 70 ) + PLACED ( 70 2940 ) E ;
END PINS

NETS 1 ;
- n1 ( PIN drv ) ( ram P[0] ) ( ram P[1] ) ( ram P[2] ) ( ram P[3] )
  ( ram P[4] ) ( ram P[5] ) ( ram P[6] ) ( ram P[7] ) + USE SIGNAL ;
END NETS

END DESIGN
